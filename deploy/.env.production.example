APP_NAME="Evident Kinerja"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --force  (SIMPAN! kehilangan key = semua token Google tidak bisa didekripsi)
APP_URL=https://evident.domain.com
APP_LOCALE=id

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evident_kinerja
DB_USERNAME=evident
DB_PASSWORD=GANTI_PASSWORD_KUAT

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=GANTI_PASSWORD_REDIS

QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=960   # WAJIB > timeout job upload (900)
CACHE_STORE=redis
SESSION_DRIVER=redis

# Di belakang Cloudflare (HTTPS): cookie hanya lewat HTTPS. Biarkan SameSite=lax (callback OAuth Google butuh lax).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=720

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

EVIDENT_DRIVE_ROOT=EvidentKinerja
EVIDENT_MAX_UPLOAD_MB=50
EVIDENT_SHORTLINK_BASE=https://evident.domain.com
EVIDENT_ADMIN_EMAILS=admin@domain.com   # boleh membuka /horizon (pisahkan dengan koma)
